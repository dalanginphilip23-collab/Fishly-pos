PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fishly_pos
# Local MySQL development. For Aiven/hosted MySQL set true and provide its CA.
DB_SSL=false
# DB_CA_CERT_BASE64=
# Alternatively use a quoted DB_CA_CERT with escaped newline characters.
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_PIN=
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Set to 1 only when the API is behind a trusted reverse proxy.
TRUST_PROXY=0
